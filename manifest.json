{
  "manifest_version": 3,
  "name": "Web Draw - 网页绘画",
  "version": "0.2.0",
  "description": "在任意网页之上用触控笔/鼠标画画,草稿跟随网页内容滚动。",
  "minimum_chrome_version": "88",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "在网页上画画",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
